{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/claude_hooks/pre_tool_use_no_secrets.py\"",
            "timeout": 60,
            "statusMessage": "No-secrets rule: scanning before git commit/push"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/claude_hooks/pre_tool_use_no_secrets.py\"",
            "timeout": 30,
            "statusMessage": "No-secrets rule: scanning the edit"
          }
        ]
      }
    ]
  }
}
