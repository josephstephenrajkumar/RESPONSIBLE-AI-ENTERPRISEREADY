# Responsible AI Enterprise Gateway backend environment variables

# ---------------------------------------------------------------------------
# LLM egress. All model calls (chat + Ragas/TruLens judges) go through one
# client. In `proxy` mode the application never holds a provider key; the
# LiteLLM proxy owns credentials, routing, retries, budgets and cost metering.
# ---------------------------------------------------------------------------
LLM_GATEWAY_MODE=proxy                      # proxy (default) | direct (break-glass only)
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_API_KEY=sk-local-dev-master-key     # virtual key in AWS; master key locally
LLM_DEFAULT_MODEL=openai/gpt-oss-120b       # must exist in litellm/config.yaml model_list
LLM_JUDGE_MODEL=                            # empty = same as LLM_DEFAULT_MODEL; try judge-fast to cut eval spend
LLM_TIMEOUT_SECONDS=25
LLM_MAX_CONNECTIONS=100
LLM_MAX_KEEPALIVE_CONNECTIONS=20
LLM_ALLOWED_MODELS=                         # optional comma-separated allowlist enforced by the gateway
LLM_PROVIDERS_ENABLED=groq                  # providers whose credentials the PROXY holds (groq, bedrock, anthropic, openai, gemini, mistral)
LITELLM_ADMIN_API_KEY=                      # LiteLLM key allowed to call /model/new; empty = LITELLM_API_KEY
BEDROCK_REGION=ap-southeast-1

# Provider key. Read by the LiteLLM container via docker compose (env_file) and
# by the backend only when LLM_GATEWAY_MODE=direct. Leave empty in the
# containerised/AWS backend.
GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1

# FinOps dashboard. 0 disables the budget gauge.
FINOPS_MONTHLY_BUDGET_USD=0
FINOPS_CURRENCY=USD

# Local development keeps auth disabled. In AWS, set AUTH_REQUIRED=true and
# configure Cognito values through Secrets Manager / Parameter Store.
# Cognito groups: admin | policy-manager | guardrails-admin | finops | aiops | sre
AUTH_REQUIRED=false
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ISSUER=
LOCAL_DEV_USER_ID=local-dev-user
LOCAL_DEV_USER_EMAIL=local@example.com

# Prefer configuring Langfuse on the LiteLLM proxy (one generation per model
# call). Setting these here as well produces duplicate traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local: sqlite:///app/storage/responsible_ai.db
# AWS Aurora PostgreSQL: postgresql+psycopg2://user:password@host:5432/responsible_ai
DATABASE_URL=sqlite:///app/storage/responsible_ai.db

OTEL_SERVICE_NAME=responsible-ai-chat-agent
JAEGER_HOST=localhost
JAEGER_PORT=6831
JAEGER_ENDPOINT=
JAEGER_UI_URL=http://localhost:16686
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Comma-separated list. Example:
# FRONTEND_ORIGINS=https://d111111abcdef8.cloudfront.net
FRONTEND_ORIGINS=

# ---------------------------------------------------------------------------
# Workflow Apps (Activepieces). docs/ACTIVEPIECES_INTEGRATION.md
# The gateway signs in to the engine with this service account (first sign-up on
# a fresh engine becomes its platform admin) and installs workflows/pieces/dist/*.tgz.
# ---------------------------------------------------------------------------
ACTIVEPIECES_ENABLED=true
ACTIVEPIECES_API_URL=http://localhost:8080             # engine as seen from the gateway
ACTIVEPIECES_PUBLIC_URL=http://localhost:8080          # engine as seen from the browser (iframes)
ACTIVEPIECES_SERVICE_EMAIL=workflow-service@responsible-ai.local
ACTIVEPIECES_SERVICE_PASSWORD=replace-me               # never commit; Secrets Manager in AWS
ACTIVEPIECES_GATEWAY_URL=http://host.docker.internal:8000   # this gateway as seen from the engine worker
ACTIVEPIECES_LITELLM_URL=http://litellm:4000           # proxy as seen from the engine worker
ACTIVEPIECES_PIECES_DIR=                               # default: <repo>/workflows/pieces/dist
WORKFLOW_BOOTSTRAP_ON_STARTUP=true
WORKFLOW_DEFAULT_BUDGET_USD=10                         # per-app monthly budget when none is given
WORKFLOW_PLATFORM_BUDGET_USD=25                        # budget of the key behind the engine's AI provider
WORKFLOW_USAGE_SYNC_SECONDS=300                        # proxy spend -> llm_usage_events
