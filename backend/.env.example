# Responsible AI Enterprise Gateway backend environment variables
GROQ_API_KEY=replace_me
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=25
GROQ_MAX_CONNECTIONS=100
GROQ_MAX_KEEPALIVE_CONNECTIONS=20

# Local development keeps auth disabled. In AWS, set AUTH_REQUIRED=true and
# configure Cognito values through Secrets Manager / Parameter Store.
AUTH_REQUIRED=false
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_ISSUER=
LOCAL_DEV_USER_ID=local-dev-user
LOCAL_DEV_USER_EMAIL=local@example.com

LANGFUSE_PUBLIC_KEY=optional
LANGFUSE_SECRET_KEY=optional
LANGFUSE_HOST=https://cloud.langfuse.com

# Local: sqlite:///app/storage/responsible_ai.db
# AWS Aurora PostgreSQL: postgresql+psycopg2://user:password@host:5432/responsible_ai
DATABASE_URL=sqlite:///app/storage/responsible_ai.db

OTEL_SERVICE_NAME=responsible-ai-chat-agent
JAEGER_HOST=localhost
JAEGER_PORT=6831
JAEGER_ENDPOINT=
JAEGER_UI_URL=http://localhost:16686
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Comma-separated list. Example:
# FRONTEND_ORIGINS=https://d111111abcdef8.cloudfront.net
FRONTEND_ORIGINS=
